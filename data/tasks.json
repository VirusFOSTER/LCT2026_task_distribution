// Примечание: данный файл является ошибкой, т. к. в формате json не бывает комеентариев
{   // <--- Здесь начинается головной объект файла
    "tasks":
    [   // <--- Здесь начинается массив
        {   // <--- Здесь начинается описание 1-й задачи
            "task_uid": ...,    /// тип int
            "task_type": ...,   /// тип int
            "task_region": ...,     /// тип string (должно быть что-то типа: "task_region": "region_1" - значение указывается в кавычки)
            "position":
            {
                "latitude": ...,    /// тип float (обязательно должна быть точка, даже если значение типа 42.0)
                "longitude": ...,   /// тип float (обязательно должна быть точка, даже если значение типа 42.0)
            },
            "time_window":
            {
                "time_begin": ...,      /// тип float (обязательно должна быть точка, даже если значение типа 42.0)
                "time_end": ...,      /// тип float (обязательно должна быть точка, даже если значение типа 42.0)
            }
        },   // <--- Здесь заканчивается описание 1-й задачи (Если это была последняя задача, запятая после скобки не ставится)
        ...
    ]   // <--- Здесь заканчивается массив
}   // <--- Здесь заканчивается головной объект файла
