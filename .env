# ─── Backend (C++ / ZeroMQ) ───────────────────────────────
ZMQ_PORT=5555
ZMQ_BIND_ADDRESS=tcp://0.0.0.0

# ─── Bridge (Node.js) ─────────────────────────────────────
BRIDGE_WS_PORT=8080
ZMQ_BACKEND_URL=tcp://backend:5555

# ─── Frontend (React) ─────────────────────────────────────
# Внимание: React читает только переменные с префиксом REACT_APP_
REACT_APP_WS_URL=ws://localhost:8080

# ─── Docker Compose ───────────────────────────────────────
FRONTEND_PORT=3000
